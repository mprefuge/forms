<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <name>Past_Ninety_Days</name>
        <label>Past ninety days?</label>
        <locationX>264</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Still inside the window</defaultConnectorLabel>
        <rules>
            <name>Yes_Past_Ninety_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Past_90_Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Office_Staff_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Chase_Task</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_Open_Chase_Yet</name>
        <label>No open chase yet?</label>
        <locationX>264</locationX>
        <locationY>492</locationY>
        <defaultConnectorLabel>Already being chased</defaultConnectorLabel>
        <rules>
            <name>Nothing_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Chase_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Chase_Task</targetReference>
            </connector>
            <label>Nothing open</label>
        </rules>
    </decisions>
    <description>Files one task for the office staff queue on every exemption certificate still Pending past Kentucky ninety day window. Past that an unsupported exemption is the organisation own tax to pay, so the flag needed something that actually asks a person to act on it.</description>
    <environments>Default</environments>
    <interviewLabel>Chase exemption certificates past 90 days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Chase Exemption Certificates Past 90 Days</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Chase_Task</name>
        <label>Create the chase task</label>
        <locationX>264</locationX>
        <locationY>708</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Chase_Task_Body</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Office_Staff_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Chase_Task_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Office_Staff_Queue</name>
        <label>Get the Office Staff queue</label>
        <locationX>264</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Past_Ninety_Days</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Office_Staff</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Chase_Task</name>
        <label>Get any open chase task</label>
        <locationX>264</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>No_Open_Chase_Yet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>138</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Office_Staff_Queue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <object>Tax_Exemption_Certificate__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-11</startDate>
            <startTime>13:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Chase_Task_Body</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Organization_Name__c} claimed a Kentucky sales tax exemption under number {!$Record.Exemption_Id__c} on {!$Record.First_Claimed_On__c}, and the certificate is still not complete after {!$Record.Days_Outstanding__c} days.

Kentucky allows a seller ninety days to obtain a purchase exemption certificate. Past that the exemption is not supportable and the tax is ours to pay, so this is money at risk rather than a reminder.

Either obtain the completed Form 51A126 and set the certificate to Complete, or mark it Rejected and re-bill the tax on the orders it covered. The Transactions related list on the certificate shows which orders those are.</text>
    </textTemplates>
    <textTemplates>
        <name>Chase_Task_Subject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Chase exemption certificate: {!$Record.Organization_Name__c} ({!$Record.Days_Outstanding__c} days)</text>
    </textTemplates>
</Flow>
