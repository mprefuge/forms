<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets the payment service record which discount code an order used. Assign it to whichever user that service authenticates as: without it the writes fail silently, because a newly deployed field is visible to nobody and Modify All Data does not cover FLS.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Discount Tracking Integration</label>
    <!--
        Read on the codes, because the service has to turn the code string in
        Stripe metadata into the record it refers to. It never writes one.
    -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Discount_Code__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Active__c</field><readable>true</readable></fieldPermissions>
    <!--
        Edit on the three transaction fields, and only those three. No object
        permission on Transaction__c is granted here: the payment service
        already has that from its profile, and this permission set exists to add
        the new fields, not to re-grant what already works.
    -->
    <fieldPermissions><editable>true</editable><field>Transaction__c.Discount_Code__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Transaction__c.Discount_Percent__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Transaction__c.Discount_Amount__c</field><readable>true</readable></fieldPermissions>
</PermissionSet>
