<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets the forms service record exemption certificates captured on an order form. Assign it to the user that service authenticates as: without it every write is dropped in silence, because a new field is visible to nobody and Modify All Data misses FLS.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Tax Exemption Integration</label>
    <!--
        Create and edit, but never delete. The service upserts on the exemption
        number, so a repeat buyer updates the certificate already on file
        rather than minting a second one - and nothing reachable from a public
        endpoint should be able to remove tax evidence.

        viewAllRecords is on because the upsert has to find a certificate that
        another user created; modifyAllRecords is off for the same reason
        delete is.
    -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Tax_Exemption_Certificate__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Exemption_Id__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Account__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Organization_Name__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Organization_Type__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Signer_Name__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Signer_Title__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Signature__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Signed_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Status__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.First_Claimed_On__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Certificate_File_Attached__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Source__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Tax_Exemption_Certificate__c.Notes__c</field><readable>true</readable></fieldPermissions>
    <!-- Formulas. Readable only, because Salesforce will not deploy an
         editable permission on a field nobody can write. -->
    <fieldPermissions><editable>false</editable><field>Tax_Exemption_Certificate__c.Days_Outstanding__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Tax_Exemption_Certificate__c.Past_90_Days__c</field><readable>true</readable></fieldPermissions>
</PermissionSet>
