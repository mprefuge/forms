<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read-only access to Discount Code records for the forms integration user (the Connected App that /api/form/discount-code authenticates as). Read is all the endpoint needs: it looks a code up and answers yes or no. It never creates, edits or deletes a code, so granting more than this would widen what a compromised endpoint could do without buying anything.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Discount Code Integration Read</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Discount_Code__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Code__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Percent_Off__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Active__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Start_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.End_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Product__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Max_Redemptions__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Times_Redeemed__c</field><readable>true</readable></fieldPermissions>
</PermissionSet>
