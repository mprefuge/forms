<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read-only access to Discount Code records for the forms integration user, which /api/form/discount-code authenticates as. The endpoint only looks codes up, so read is all it needs; more would widen what a compromised endpoint could reach.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Discount Code Integration Read</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Discount_Code__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!--
        Code__c and Percent_Off__c are deliberately absent. Both are required
        fields, and Salesforce refuses field permissions on a required field
        ("You cannot deploy to a required field") because it is always readable
        to anyone who can see the record. Adding them back breaks the deploy;
        leaving them out costs the endpoint nothing, since object read already
        covers them.
    -->
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Active__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Start_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.End_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Max_Redemptions__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Times_Redeemed__c</field><readable>true</readable></fieldPermissions>
    <!-- The forms service writes both of these when it records an order: the
         code the buyer used, and whether they are paying by card or by check.
         Without the write the order saves with them blank and the Check
         Redemptions rollup counts nothing - silently, the way a missing FLS
         always fails. -->
    <fieldPermissions><editable>true</editable><field>Form__c.Discount_Code__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Form__c.Payment_Method__c</field><readable>true</readable></fieldPermissions>
    <!--
        BOTH halves of the redemption count, not just the total. The endpoint's
        query names Check_Redemptions__c explicitly, and a SOQL query is filtered
        by field-level security: a field this user cannot read is rejected as "No
        such column", which fails the whole query and 502s the endpoint. Granting
        only the formula looked sufficient and took the discount box down in
        production until this line existed.
    -->
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Check_Redemptions__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Discount_Code__c.Total_Redemptions__c</field><readable>true</readable></fieldPermissions>
</PermissionSet>
