<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets staff create, edit and retire discount codes. Assign it to whoever decides discounts: without it they cannot see the Active tick or the dates, because deploying fields grants no field-level security to anyone, System Administrators included.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Discount Code Manager</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Discount_Code__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!--
        Code__c and Percent_Off__c are absent for the same reason as in the
        integration permission set: they are required fields, and Salesforce
        refuses field permissions on those. They are always visible and editable
        to anyone who can see the record, so nothing is lost.
    -->
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.Active__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.Start_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.End_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.Max_Redemptions__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.Times_Redeemed__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Discount_Code__c.Notes__c</field><readable>true</readable></fieldPermissions>
    <!-- Read-only on the transaction side: staff read what a code did, they do
         not hand-edit what a payment recorded. -->
    <fieldPermissions><editable>false</editable><field>Transaction__c.Discount_Code__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Transaction__c.Discount_Percent__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Transaction__c.Discount_Amount__c</field><readable>true</readable></fieldPermissions>
    <tabSettings>
        <tab>Discount_Code__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
