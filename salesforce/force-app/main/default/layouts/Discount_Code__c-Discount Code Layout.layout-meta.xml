<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <excludeButtons>OpenSlackRecordChannel</excludeButtons>
    <excludeButtons>Submit</excludeButtons>
    <!--
        Replaces the layout Salesforce generates for a new object, which lists
        every field in one "Information" section in no particular order - Owner
        next to Percent Off, the redemption counter above the dates. Grouped
        here the way somebody setting up a code actually thinks: what the code
        is, when it runs, how far it goes, and who it went to.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>The Code</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Name</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Code__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Percent_Off__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Active__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Campaign__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>When It Applies</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Start_Date__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>End_Date__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Usage</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Max_Redemptions__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <!--
                All three read-only on purpose: each is maintained by something
                else - a DLRS rollup over Transaction__c, a flow over Form__c,
                and a formula. Anything typed in here is overwritten the next
                time an order touches the code, so an editable box would only
                invite somebody to "correct" it and be puzzled.

                TOTAL FIRST, because it is the one that answers the question
                people bring to this page. Paid Redemptions sat at the top of
                this section under the name "Times Redeemed" and read zero
                while real check orders were coming in, which is exactly the
                wrong thing for the most prominent number on the page to do.
            -->
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Total_Redemptions__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Times_Redeemed__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Check_Redemptions__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Internal</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Notes__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>OwnerId</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>CreatedById</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>LastModifiedById</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Custom Links</label>
        <layoutColumns/>
        <layoutColumns/>
        <layoutColumns/>
        <style>CustomLinks</style>
    </layoutSections>
    <miniLayout>
        <fields>Code__c</fields>
        <fields>Percent_Off__c</fields>
        <fields>Active__c</fields>
    </miniLayout>
    <!--
        The whole point of the exercise: what has this code actually sold.
        Named ChildObject.LookupField, which is how the org's existing custom
        related lists are written (Campaign carries Transaction__c.Campaign__c
        and Form__c.Campaign__c) - NOT the relationship name.

        Newest first, because the question asked of this list is almost always
        "did the order that just came in land against this code".
    -->
    <relatedLists>
        <fields>NAME</fields>
        <fields>Received_At__c</fields>
        <fields>Status__c</fields>
        <fields>Amount_Gross__c</fields>
        <fields>Discount_Percent__c</fields>
        <fields>Discount_Amount__c</fields>
        <fields>Campaign__c</fields>
        <relatedList>Transaction__c.Discount_Code__c</relatedList>
        <sortField>Received_At__c</sortField>
        <sortOrder>Desc</sortOrder>
    </relatedLists>
    <relatedLists>
        <relatedList>RelatedHistoryList</relatedList>
    </relatedLists>
    <showEmailCheckbox>false</showEmailCheckbox>
    <showHighlightsPanel>true</showHighlightsPanel>
    <showInteractionLogPanel>false</showInteractionLogPanel>
    <showRunAssignmentRulesCheckbox>false</showRunAssignmentRulesCheckbox>
    <showSubmitAndAttachButton>false</showSubmitAndAttachButton>
    <summaryLayout>
        <masterLabel>00hUQ000002XXKD</masterLabel>
        <sizeX>4</sizeX>
        <sizeY>0</sizeY>
        <summaryLayoutStyle>Default</summaryLayoutStyle>
    </summaryLayout>
</Layout>
