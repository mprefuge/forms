<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <excludeButtons>OpenSlackRecordChannel</excludeButtons>
    <excludeButtons>Submit</excludeButtons>
    <!--
        Grouped the way somebody reviewing a certificate reads one: who claims
        the exemption, on what authority they signed it, and how much longer
        the claim can stand without paperwork. The default generated layout
        puts Owner between Signature and Signed Date, which reads as noise on
        a record whose whole job is to be legible under audit.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Who Is Exempt</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Name</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Organization_Name__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Account__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Exemption_Id__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Organization_Type__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>The Signature</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Signer_Name__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Signer_Title__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <!--
                Signature sits beside Signer Name so the two can be read
                against each other without scrolling. A certificate where they
                disagree is one to look at before the exemption is relied on.
            -->
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Signature__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Signed_Date__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Standing</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Status__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>First_Claimed_On__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Certificate_File_Attached__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <!--
                Both are formulas, so read-only is the only honest behaviour.
                Past 90 Days is the one that costs money: past Kentucky's
                window an unsupported exemption is the organisation's own tax
                to pay.
            -->
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Days_Outstanding__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Past_90_Days__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Internal</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Notes__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Source__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>OwnerId</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>CreatedById</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>LastModifiedById</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Custom Links</label>
        <layoutColumns/>
        <layoutColumns/>
        <layoutColumns/>
        <style>CustomLinks</style>
    </layoutSections>
    <miniLayout>
        <fields>Organization_Name__c</fields>
        <fields>Status__c</fields>
        <fields>Exemption_Id__c</fields>
    </miniLayout>
    <!--
        What this certificate has actually been used to exempt. Named
        ChildObject.LookupField, matching how the org's other custom related
        lists are written - NOT the relationship name.

        Amount Gross and Tax Amount are both here on purpose: Tax Amount
        should read $0.00 on every row. A row where it does not is an order
        that was taxed and pointed at a certificate anyway, which is a
        contradiction worth seeing.
    -->
    <relatedLists>
        <fields>NAME</fields>
        <fields>Received_At__c</fields>
        <fields>Status__c</fields>
        <fields>Amount_Gross__c</fields>
        <fields>Tax_Base__c</fields>
        <fields>Tax_Amount__c</fields>
        <fields>Tax_State__c</fields>
        <relatedList>Transaction__c.Tax_Exemption_Certificate__c</relatedList>
        <sortField>Received_At__c</sortField>
        <sortOrder>Desc</sortOrder>
    </relatedLists>
    <relatedLists>
        <relatedList>RelatedFileList</relatedList>
    </relatedLists>
    <relatedLists>
        <relatedList>RelatedHistoryList</relatedList>
    </relatedLists>
    <showEmailCheckbox>false</showEmailCheckbox>
    <showHighlightsPanel>true</showHighlightsPanel>
    <showInteractionLogPanel>false</showInteractionLogPanel>
    <showRunAssignmentRulesCheckbox>false</showRunAssignmentRulesCheckbox>
    <showSubmitAndAttachButton>false</showSubmitAndAttachButton>
    <summaryLayout>
        <masterLabel>Highlights Panel</masterLabel>
        <sizeX>4</sizeX>
        <sizeY>0</sizeY>
        <summaryLayoutStyle>Default</summaryLayoutStyle>
    </summaryLayout>
</Layout>
