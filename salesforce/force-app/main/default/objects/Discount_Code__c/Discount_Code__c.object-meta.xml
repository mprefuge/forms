<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Drives the highlights panel: code, percentage, active, redemptions -
         the four things somebody scanning a code record wants without scrolling. -->
    <compactLayoutAssignment>Discount_Code_Compact</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
